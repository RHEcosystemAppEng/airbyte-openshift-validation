# Example only; do not apply directly.
# Create the Secret with real values before installing Airbyte:
#
#   oc create secret generic airbyte-config-secrets \
#     --from-literal=s3-access-key-id='REPLACE_ME' \
#     --from-literal=s3-secret-access-key='REPLACE_ME' \
#     --namespace airbyte-validation
#
apiVersion: v1
kind: Secret
metadata:
  name: airbyte-config-secrets
  namespace: airbyte-validation
type: Opaque
stringData:
  s3-access-key-id: REPLACE_ME
  s3-secret-access-key: REPLACE_ME
