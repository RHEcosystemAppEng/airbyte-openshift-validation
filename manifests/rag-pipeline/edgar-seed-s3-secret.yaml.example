# Example only; do not apply directly.
#
# Create the Secret that Ray head/workers/submitter consume via envFrom:
#
#   oc create secret generic edgar-seed-s3 \
#     --from-literal=AWS_ACCESS_KEY_ID='REPLACE_ME' \
#     --from-literal=AWS_SECRET_ACCESS_KEY='REPLACE_ME' \
#     --from-literal=AWS_DEFAULT_REGION='us-east-1' \
#     --from-literal=S3_ENDPOINT='' \
#     --from-literal=S3_BUCKET='REPLACE_BUCKET' \
#     --from-literal=S3_PREFIX='edgar-seed' \
#     -n airbyte-validation \
#     --dry-run=client -o yaml | oc apply -f -
#
# Leave S3_ENDPOINT empty for AWS S3. Set it for ODF / MinIO-compatible stores.
# Expected object layout under s3://$S3_BUCKET/$S3_PREFIX/:
#   drive/legal/
#   drive/compliance/
#   factsheets/
#   manifests/seed-manifest.json
apiVersion: v1
kind: Secret
metadata:
  name: edgar-seed-s3
  namespace: airbyte-validation
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: REPLACE_ME
  AWS_SECRET_ACCESS_KEY: REPLACE_ME
  AWS_DEFAULT_REGION: us-east-1
  S3_ENDPOINT: ""
  S3_BUCKET: REPLACE_BUCKET
  S3_PREFIX: edgar-seed
